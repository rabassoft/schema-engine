{
  "name": "@rabassoft/schema-engine-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "audit:release": "pnpm build && node scripts/verify-release-security.mjs",
    "build": "pnpm -r --if-present build",
    "docs:check": "node scripts/verify-documentation.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare:release": "pnpm build && pnpm test:artifacts && pnpm audit:release && node scripts/prepare-public-candidates.mjs --release-version=0.2.0",
    "reference:build": "pnpm --filter '@schema-engine-internal/reference-angular...' build",
    "reference:dev": "pnpm reference:snippets && pnpm reference:build && pnpm --parallel --filter @schema-engine-internal/reference-scenarios --filter @schema-engine-internal/reference-angular run dev",
    "reference:snippets": "node scripts/extract-reference-snippets.mjs --write",
    "reference:snippets:check": "node scripts/extract-reference-snippets.mjs --check",
    "reference:test:boundaries": "node scripts/verify-reference-boundaries.mjs",
    "reference:test:e2e": "pnpm reference:build && pnpm exec playwright test --config apps/reference-angular/playwright.config.ts",
    "reference:test:unit": "pnpm reference:build && pnpm --filter @schema-engine-internal/reference-scenarios --filter @schema-engine-internal/reference-angular run test",
    "test": "pnpm build && pnpm -r --if-present test",
    "test:artifacts": "pnpm build && node scripts/verify-packed-artifacts.mjs --release-version=0.2.0",
    "test:consumer": "pnpm build && pnpm --filter @rabassoft/schema-engine-angular exec vitest run test/consumer.test.ts",
    "test:consumer:angular-candidate": "pnpm build && node scripts/verify-clean-consumers.mjs --live-core --live-version=0.2.0 --angular-tarball=.release/0.2.0/rabassoft-schema-engine-angular-0.2.0.tgz",
    "test:consumer:clean": "pnpm build && node scripts/verify-clean-consumers.mjs",
    "test:live:core": "node scripts/verify-live-core.mjs",
    "test:live:angular": "node scripts/verify-live-angular.mjs && node scripts/verify-clean-consumers.mjs --live-core --live-angular --live-version=0.1.0",
    "test:live:0.2:exact": "node scripts/verify-live-candidates.mjs --release-version=0.2.0 --tag-mode=none && node scripts/verify-clean-consumers.mjs --live-core --live-angular --live-version=0.2.0",
    "test:live:0.2:next": "node scripts/verify-live-candidates.mjs --release-version=0.2.0 --tag-mode=next && node scripts/verify-clean-consumers.mjs --live-core --live-angular --live-version=0.2.0 --live-specifier=next",
    "test:live:0.2:latest": "node scripts/verify-live-candidates.mjs --release-version=0.2.0 --tag-mode=both && node scripts/verify-clean-consumers.mjs --live-core --live-angular --live-version=0.2.0 --live-specifier=latest && node scripts/verify-clean-consumers.mjs --live-core --live-angular --live-version=0.2.0 --live-specifier=unqualified",
    "test:package": "pnpm build && pnpm -r --if-present test:package",
    "test:release:tooling": "node --test scripts/release-target.test.mjs",
    "test:source": "pnpm build && node scripts/verify-source-packages.mjs",
    "test:source:angular-candidate": "pnpm build && node scripts/verify-source-packages.mjs --core-tarball=.release/0.2.0/rabassoft-schema-engine-0.2.0.tgz --angular-tarball=.release/0.2.0/rabassoft-schema-engine-angular-0.2.0.tgz",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@angular/build": "22.0.6",
    "@angular/cli": "22.0.6",
    "@angular/common": "22.0.6",
    "@angular/compiler": "22.0.6",
    "@angular/compiler-cli": "22.0.6",
    "@angular/core": "22.0.6",
    "@angular/forms": "22.0.6",
    "@angular/platform-browser": "22.0.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.5",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
