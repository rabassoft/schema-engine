{
  "name": "@rabassoft/schema-engine-angular",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "ngc -p tsconfig.build.json",
    "test": "pnpm build && vitest run",
    "test:package": "node test/package-smoke.mjs",
    "typecheck": "pnpm build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@rabassoft/schema-engine": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": ">=22.0.6 <23.0.0",
    "@angular/forms": ">=22.0.6 <23.0.0",
    "@rabassoft/schema-engine": "workspace:^"
  }
}
