{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "nullableAmount": {
      "type": ["null", "number"],
      "minimum": 0
    }
  },
  "properties": {
    "stringFirst": { "type": ["string", "null"], "minLength": 1 },
    "nullString": { "type": ["null", "string"] },
    "numberFirst": { "type": ["number", "null"] },
    "nullNumber": { "type": ["null", "number"] },
    "integerFirst": { "type": ["integer", "null"] },
    "nullInteger": { "type": ["null", "integer"] },
    "booleanFirst": { "type": ["boolean", "null"] },
    "nullBoolean": { "type": ["null", "boolean"] },
    "nested": {
      "type": "object",
      "properties": {
        "value": { "type": ["string", "null"] }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "amount": { "$ref": "#/$defs/nullableAmount" }
        },
        "required": ["id"]
      }
    }
  }
}
