{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "active": { "type": "boolean" }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "details": {
            "type": "object",
            "properties": { "active": { "type": "boolean" } }
          }
        },
        "required": ["id"]
      }
    }
  }
}
