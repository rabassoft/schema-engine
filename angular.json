{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "apps",
  "projects": {
    "reference-angular": {
      "projectType": "application",
      "root": "apps/reference-angular",
      "sourceRoot": "apps/reference-angular/src",
      "prefix": "reference",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/reference-angular/src/main.ts",
            "index": "apps/reference-angular/src/index.html",
            "tsConfig": "apps/reference-angular/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/reference-angular/public"
              }
            ],
            "styles": ["apps/reference-angular/src/styles.css"],
            "outputPath": "dist/apps/reference-angular"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "prebundle": {
              "exclude": ["@schema-engine-internal/reference-scenarios"]
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "reference-angular:build:production"
            },
            "development": {
              "buildTarget": "reference-angular:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
